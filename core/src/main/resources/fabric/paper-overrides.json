{
  "lithium:options": {
    "mixin.ai.pathing": false,
    "mixin.ai.poi": false,
    "mixin.ai.task.replace_streams": false,
    "mixin.alloc.chunk_random": false,
    "mixin.alloc.deep_passengers": false,
    "mixin.alloc.entity_tracker": false,
    "mixin.alloc.nbt": false,
    "mixin.block.flatten_states": false,
    "mixin.block.hopper": false,
    "mixin.chunk.entity_class_groups": false,
    "mixin.chunk.no_locking": false,
    "mixin.chunk.no_validation": false,
    "mixin.collections.chunk_tickets": false,
    "mixin.collections.entity_ticking": false,
    "mixin.entity.collisions.block_effects": false,
    "mixin.entity.collisions.intersection": false,
    "mixin.entity.collisions.movement": false,
    "mixin.entity.collisions.unpushable_cramming": false,
    "mixin.entity.replace_entitytype_predicates": false,
    "mixin.experimental.entity.item_entity_merging": false,
    "mixin.math.fast_blockpos": false,
    "mixin.math.fast_util": false,
    "mixin.minimal_nonvanilla.collisions.empty_space": false,
    "mixin.minimal_nonvanilla.spawning": false,
    "mixin.minimal_nonvanilla.world.expiring_chunk_tickets": false,
    "mixin.shapes.blockstate_cache": false,
    "mixin.shapes.optimized_matching": false,
    "mixin.shapes.specialized_shapes": false,
    "mixin.util.block_tracking": false,
    "mixin.util.chunk_status_tracking": false,
    "mixin.util.data_storage": false,
    "mixin.util.entity_movement_tracking": false,
    "mixin.world.block_entity_ticking": false,
    "mixin.world.chunk_access": false,
    "mixin.world.chunk_ticking.random_block_ticking": false,
    "mixin.world.explosions.block_raycast": false,
    "mixin.world.game_events.dispatch": false,
    "mixin.world.inline_height": false,
    "mixin.world.raycast": false,
    "mixin.world.temperature_cache": false,
    "mixin.world.tick_scheduler": false
  },
  "ferritecore:disabled_options": [
    "replaceNeighborLookup",
    "replacePropertyMap",
    "blockstateCacheDeduplication"
  ],
  "horizon:disabled_mixins": {
    "chunky": [
      "org.popcraft.chunky.mixin.MinecraftServerMixin",
      "org.popcraft.chunky.mixin.ServerLevelMixin"
    ],
    "fabric-data-generation-api-v1": [
      "net.fabricmc.fabric.mixin.datagen.server.MainMixin"
    ],
    "lithium": [
      "net.caffeinemc.mods.lithium.mixin.util.accessors.ServerLevelAccessor"
    ],
    "vmp": [
      "com.ishland.vmp.mixins.networking.no_flush.MixinClientConnection",
      "com.ishland.vmp.mixins.playerwatching.*",
      "com.ishland.vmp.mixins.ticketsystem.*"
    ]
  },
  "horizon:mixin_patches": {
    "fabric-lifecycle-events-v1": {
      "net.fabricmc.fabric.mixin.event.lifecycle.MinecraftServerMixin#afterShutdownServer": {
        "at": {
          "value": "INVOKE",
          "target": "Lnet/minecraft/server/MinecraftServer;onServerExit()V"
        }
      },
      "net.fabricmc.fabric.mixin.event.lifecycle.MinecraftServerMixin#onLoadWorld": {
        "method": "addLevel"
      },
      "net.fabricmc.fabric.mixin.event.lifecycle.MinecraftServerMixin#onUnloadWorldAtShutdown": {
        "disable": true
      },
      "net.fabricmc.fabric.mixin.event.lifecycle.PlayerListMixin#hookOnDataPacksReloaded": {
        "at": {
          "target": "Lnet/minecraft/server/players/PlayerList;reloadTagData()V"
        }
      }
    },
    "fabric-permission-api-v1": {
      "net.fabricmc.fabric.mixin.permission.CommandSourceStackMixin#copyOriginalOwner": {
        "method": "/^with/ desc=/Lnet.minecraft.commands.CommandSourceStack;$/"
      }
    },
    "fabric-registry-sync-v0": {
      "net.fabricmc.fabric.mixin.registry.sync.BootstrapMixin#delayRegistryFreeze": {
        "disable": true
      }
    }
  }
}
