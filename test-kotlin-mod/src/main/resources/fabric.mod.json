{
  "schemaVersion": 1,
  "id": "horizon-kotlin-testmod",
  "version": "1.0.0-SNAPSHOT",
  "name": "Horizon Kotlin Test Mod",
  "description": "Kotlin entrypoints and the libraries fabric-language-kotlin bundles",
  "authors": [
    "CanvasMC"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.canvasmc.testkotlin.TestKotlinMod"
      },
      {
        "adapter": "kotlin",
        "value": "io.canvasmc.testkotlin.TestKotlinClass"
      },
      {
        "adapter": "kotlin",
        "value": "io.canvasmc.testkotlin.TestKotlinModKt::onMain"
      }
    ],
    "server": [
      {
        "adapter": "kotlin",
        "value": "io.canvasmc.testkotlin.TestKotlinMod::server"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-language-kotlin": ">=1.14.0",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": ">=26.1"
  }
}
